{
  "info": {
    "_postman_id": "b2d2c3f0-aaaa-bbbb-cccc-123456789000",
    "name": "Aereopuertos API (Django + Postgres + JWT + Mongo)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "airlineId", "value": "" },
    { "key": "flightEventId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Public) - POST /api/auth/register/",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user1\",\n  \"email\": \"user1@mail.com\",\n  \"password\": \"123456\"\n}"
            }
          }
        },
        {
            "name": "Login (JWT) - POST /api/auth/login/ (save tokens)",
            "event": [
                {
                "listen": "test",
                "script": {
                    "type": "text/javascript",
                    "exec": [
                    "let jsonData = {};",
                    "try { jsonData = pm.response.json(); } catch (e) {}",
                    "",
                    "if (jsonData.access) {",
                    "  pm.collectionVariables.set('accessToken', jsonData.access);",
                    "  pm.environment.set('accessToken', jsonData.access);",
                    "}",
                    "",
                    "if (jsonData.refresh) {",
                    "  pm.collectionVariables.set('refreshToken', jsonData.refresh);",
                    "  pm.environment.set('refreshToken', jsonData.refresh);",
                    "}",
                    "",
                    "pm.test('Token access recibido', function () {",
                    "  pm.expect(jsonData.access).to.be.a('string');",
                    "});"
                    ]
                }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                { "key": "Content-Type", "value": "application/json" }
                ],
                "url": { "raw": "{{baseUrl}}/api/auth/login/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login", ""] },
                "body": {
                "mode": "raw",
                "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
                }
            }
        },
        {
          "name": "Refresh (JWT) - POST /api/auth/refresh/ (save access)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData = {};",
                  "try { jsonData = pm.response.json(); } catch (e) {}",
                  "if (jsonData.access) pm.collectionVariables.set('accessToken', jsonData.access);",
                  "pm.test('Token access refrescado', function () { pm.expect(jsonData.access).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh/", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Postgres - Gates",
      "item": [
        {
          "name": "List gates (Public) - GET /api/gates/",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/gates/", "host": ["{{baseUrl}}"], "path": ["api", "gates", ""] }
          }
        },
        {
          "name": "Create gate (Admin) - POST /api/gates/",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/gates/", "host": ["{{baseUrl}}"], "path": ["api", "gates", ""] },
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"A1\",\n  \"terminal\": \"T1\",\n  \"is_available\": true\n}" }
          }
        }
      ]
    },
    {
      "name": "Postgres - Flights",
      "item": [
        {
          "name": "List flights (Public) - GET /api/flights/",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/flights/", "host": ["{{baseUrl}}"], "path": ["api", "flights", ""] }
          }
        },
        {
          "name": "Create flight (Admin) - POST /api/flights/",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/flights/", "host": ["{{baseUrl}}"], "path": ["api", "flights", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gate\": 1,\n  \"flight_number\": \"AA1234\",\n  \"destination\": \"UIO\",\n  \"status\": \"SCHEDULED\",\n  \"departure_time\": \"2026-12-10T10:00:00Z\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Mongo - Airlines",
      "item": [
        {
          "name": "List airlines (Auth) - GET /api/airlines/",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/airlines/", "host": ["{{baseUrl}}"], "path": ["api", "airlines", ""] }
          }
        },
        {
          "name": "Create airline (Auth) - POST /api/airlines/ (save airlineId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData = {};",
                  "try { jsonData = pm.response.json(); } catch (e) {}",
                  "if (jsonData.id) pm.collectionVariables.set('airlineId', jsonData.id);",
                  "pm.test('Se creó airline', function () { pm.expect(jsonData.id).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/airlines/", "host": ["{{baseUrl}}"], "path": ["api", "airlines", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"American Airlines\",\n  \"code\": \"AA\",\n  \"country\": \"USA\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Get airline by id (Auth) - GET /api/airlines/:id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/airlines/{{airlineId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "airlines", "{{airlineId}}", ""]
            }
          }
        },
        {
          "name": "Patch airline (Auth) - PATCH /api/airlines/:id",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/airlines/{{airlineId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "airlines", "{{airlineId}}", ""]
            },
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}" }
          }
        },
        {
          "name": "Delete airline (Auth) - DELETE /api/airlines/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/airlines/{{airlineId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "airlines", "{{airlineId}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Mongo - Flight Events",
      "item": [
        {
          "name": "List flight events (Auth) - GET /api/flight-events/",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/flight-events/", "host": ["{{baseUrl}}"], "path": ["api", "flight-events", ""] }
          }
        },
        {
          "name": "Create flight event (Auth) - POST /api/flight-events/ (save flightEventId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let jsonData = {};",
                  "try { jsonData = pm.response.json(); } catch (e) {}",
                  "if (jsonData.id) pm.collectionVariables.set('flightEventId', jsonData.id);",
                  "pm.test('Se creó flight event', function () { pm.expect(jsonData.id).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/flight-events/", "host": ["{{baseUrl}}"], "path": ["api", "flight-events", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flight_id\": 1,\n  \"event_type\": \"DELAYED\",\n  \"source\": \"SYSTEM\",\n  \"note\": \"Vuelo retrasado por clima\"\n}"
            }
          }
        },
        {
          "name": "Get flight event by id (Auth) - GET /api/flight-events/:id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/flight-events/{{flightEventId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flight-events", "{{flightEventId}}", ""]
            }
          }
        },
        {
          "name": "Patch flight event (Auth) - PATCH /api/flight-events/:id",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/flight-events/{{flightEventId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flight-events", "{{flightEventId}}", ""]
            },
            "body": { "mode": "raw", "raw": "{\n  \"note\": \"Nota actualizada desde Postman\"\n}" }
          }
        },
        {
          "name": "Delete flight event (Auth) - DELETE /api/flight-events/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/flight-events/{{flightEventId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "flight-events", "{{flightEventId}}", ""]
            }
          }
        }
      ]
    }
  ]
}